{
  /**
   * Puts the shared build tooling under the compiler. `tools/` sits outside every
   * package's include glob, so a typo in the Vitest base config (a singular
   * `threshold`, a misspelled provider) type-checked nowhere and would have
   * silently disabled the coverage gate with all four pipeline gates still green.
   *
   * Run from the root `type-check` script, not through turbo: tools/ is not a
   * workspace package.
   */
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
