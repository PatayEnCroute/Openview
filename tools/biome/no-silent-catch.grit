// Enforces AGENTS.md 1.3: no exception swallowing.
// Biome's `noEmptyBlockStatements` only fires on a bare `catch {}`. It stays silent
// on `catch { /* ignore */ }`, which is the form an assistant actually writes.
// Matching on the AST ignores comments, so both forms are caught here.
//
// Both the bound and unbound spellings must be listed: `catch (_e) { /* ignore */ }`
// otherwise escapes every layer, since the underscore prefix also exempts the
// binding from `noUnusedVariables`.
//
// And both must be listed AGAIN with a `finally` clause. Biome parses a try with a
// finally as a different node than a try without one, so a snippet written without
// `finally` cannot match `catch { /* ignore */ } finally { ... }` -- which is
// exactly the shape a swallowed error takes around cleanup code, and which slipped
// past this plugin and `noEmptyBlockStatements` both.
language js(typescript)

or {
  `try { $tryBody } catch { } finally { $finallyBody }` where {
    register_diagnostic(span=$tryBody, message="Empty catch block swallows the error (AGENTS.md 1.3). Log it, or rethrow a typed error with an explicit message. A comment does not count as handling, and a `finally` clause does not handle the error either.", severity="error")
  },
  `try { $tryBody } catch ($err) { } finally { $finallyBody }` where {
    register_diagnostic(span=$tryBody, message="Empty catch block swallows the error (AGENTS.md 1.3). Log it, or rethrow a typed error with an explicit message. Naming the binding `_err` does not count as handling, and a `finally` clause does not handle the error either.", severity="error")
  },
  `try { $tryBody } catch { }` where {
    register_diagnostic(span=$tryBody, message="Empty catch block swallows the error (AGENTS.md 1.3). Log it, or rethrow a typed error with an explicit message. A comment does not count as handling.", severity="error")
  },
  `try { $tryBody } catch ($err) { }` where {
    register_diagnostic(span=$tryBody, message="Empty catch block swallows the error (AGENTS.md 1.3). Log it, or rethrow a typed error with an explicit message. Naming the binding `_err` does not count as handling.", severity="error")
  }
}
