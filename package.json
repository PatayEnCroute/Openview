{
  "name": "openview-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Openview - Concepteur visuel de modèles et moteur de rendu de documents, embarquables",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node tools/setup-hooks.mjs",
    "test": "turbo run build && vitest run",
    "test:coverage": "turbo run build && vitest run --coverage",
    "type-check": "turbo run type-check && tsc -p tsconfig.tooling.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@vitest/coverage-v8": "^4.1.11",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
