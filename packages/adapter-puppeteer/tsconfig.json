{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* The one package that legitimately knows both runtimes. It is a Node process, and it also
       runs measurement callbacks INSIDE Chromium through `page.evaluate`, so DOM typings belong
       here -- and only here. `core` and `engine` still declare no DOM, which is what keeps the
       browser out of the pipeline rather than a comment in this file. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  /* All four spellings the Vitest glob runs: missing one publishes a spec file into the tarball
     with a top-level `vitest` import consumers do not install. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
