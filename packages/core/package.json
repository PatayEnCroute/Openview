{
  "name": "@openview/core",
  "version": "0.1.0",
  "description": "Schémas de données, types partagés et parsing des templates pour Openview",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
