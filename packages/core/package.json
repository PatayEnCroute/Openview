{
  "name": "@openview/core",
  "version": "0.1.0",
  "description": "Schémas de données, types partagés et parsing des templates pour Openview",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatayEnCroute/Openview.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/PatayEnCroute/Openview#readme",
  "bugs": {
    "url": "https://github.com/PatayEnCroute/Openview/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../tools/clean.mjs",
    "dev": "tsc --watch",
    "type-check": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "keywords": [
    "openview",
    "core",
    "schema",
    "templates"
  ]
}
