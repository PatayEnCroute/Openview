{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Isomorphic pure-TS package: no DOM, no Node globals, no ambient types.
       NodeNext resolution forces explicit .js extensions on relative imports,
       so the emitted ESM stays loadable by Node without a bundler. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": [],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  /* TypeScript globs have no brace expansion, so all four spellings the Vitest
     glob runs are listed. Missing one is not cosmetic: `*.spec.ts` was absent, so
     a spec file was compiled into dist/ and published in the tarball with a
     top-level `vitest` import that consumers do not install. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
