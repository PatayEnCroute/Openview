{
  "name": "@openview/engine",
  "version": "0.1.0",
  "description": "Moteur de fusion de données et de rendu backend pour Openview",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatayEnCroute/Openview.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/PatayEnCroute/Openview#readme",
  "bugs": {
    "url": "https://github.com/PatayEnCroute/Openview/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../tools/clean.mjs",
    "type-check": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@openview/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
