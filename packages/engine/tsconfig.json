{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Node service: Node globals, no DOM. The DOM built by the render pipeline
       lives inside the browser context (page.evaluate), never in this process,
       so exposing DOM typings here would let that confusion compile. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  /* TypeScript globs have no brace expansion, so all four spellings the Vitest
     glob runs are listed. Missing one is not cosmetic: `*.spec.ts` was absent, so
     a spec file was compiled into dist/ and published in the tarball with a
     top-level `vitest` import that consumers do not install. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
