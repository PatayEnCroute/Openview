# Local tooling state (embedding caches, episodic stores). Binary SQLite files
# that get rewritten on every run: never useful in history, and on a public
# repository their contents are not reviewable in a diff.
data/
*.sqlite
*.sqlite3
*.db

# Caches
.cache/
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/

# Temp files
*.tmp
*.temp
