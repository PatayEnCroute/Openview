{
  /* Deliberately `.jsonc`, not `.json`. Biome's loader accepts a comment in a
     plain `biome.json` and then silently DISCARDS every key after it -- the
     `overrides` array below vanished, with no error and no warning, and all
     three architecture guards stopped firing while `pnpm run lint` still
     reported success. Verified on 2.5.8: same content as `.jsonc` works. */
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    /* The last entry is the E7 reference batch, and it is excluded for the same
       reason as the lockfile above it: its BYTES are the contract. The manifest is
       written by `serializeManifest()`, which must read back byte for byte, and
       Biome's json formatter collapses a short array onto one line where
       `JSON.stringify(…, null, 2)` never does. `pnpm run lint:fix` would therefore
       rewrite the reference, the manifest would stop matching what the generator
       produces, and the E7 gate would go permanently red for a reason that has
       nothing to do with a document. This is not loosening a guard that is doing its
       job (AGENTS.md 7): the formatter would destroy the evidence it is pointed at. */
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.turbo",
      "!pnpm-lock.yaml",
      "!tests/golden/e7/references"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noEmptyBlockStatements": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "plugins": ["./tools/biome/no-double-cast.grit", "./tools/biome/no-silent-catch.grit"],
  /* Architecture guards use `patterns`, not `paths`. `paths` compares the specifier
     as an exact string, so `react-dom` never matched `react-dom/client` -- the
     canonical React 19 entry point -- nor `react/jsx-runtime`, `react-dom/server`
     or `puppeteer-core`. Each group therefore lists the bare name AND its
     subpaths, plus the `-core` sibling packages that ship the same thing under
     another name. */
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["react", "react/**", "react-dom", "react-dom/**"],
                    "message": "@openview/core must stay isomorphic (AGENTS.md 2): no UI dependency."
                  },
                  {
                    "group": [
                      "puppeteer",
                      "puppeteer/**",
                      "puppeteer-core",
                      "puppeteer-core/**",
                      "playwright",
                      "playwright/**",
                      "playwright-core",
                      "playwright-core/**"
                    ],
                    "message": "@openview/core must stay isomorphic (AGENTS.md 2): no server dependency."
                  },
                  {
                    "group": [
                      "@openview/designer",
                      "@openview/designer/**",
                      "@openview/engine",
                      "@openview/engine/**",
                      "@openview/viewer",
                      "@openview/viewer/**"
                    ],
                    "message": "core is the root of the dependency graph and must never import a sibling package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["react", "react/**", "react-dom", "react-dom/**"],
                    "message": "@openview/engine is a Node service (AGENTS.md 2): no UI dependency."
                  },
                  {
                    "group": [
                      "puppeteer",
                      "puppeteer/**",
                      "puppeteer-core",
                      "puppeteer-core/**",
                      "playwright",
                      "playwright/**",
                      "playwright-core",
                      "playwright-core/**"
                    ],
                    "message": "Puppeteer and Playwright bundle a browser (~150-300 MB). They belong in their own adapter package behind the RenderPort, so integrators who only need HTML never download one."
                  },
                  {
                    "group": [
                      "@openview/designer",
                      "@openview/designer/**",
                      "@openview/viewer",
                      "@openview/viewer/**"
                    ],
                    "message": "the engine must not depend on the UI layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/designer/**", "packages/viewer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "puppeteer",
                      "puppeteer/**",
                      "puppeteer-core",
                      "puppeteer-core/**",
                      "playwright",
                      "playwright/**",
                      "playwright-core",
                      "playwright-core/**"
                    ],
                    "message": "browser packages must not pull the render backend into the bundle."
                  },
                  {
                    "group": ["@openview/engine", "@openview/engine/**"],
                    "message": "the UI must reach the engine through a port, never by importing it (Hexagonal). Importing it ships Chromium to the browser bundle."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      /* Enforces AGENTS.md, "Ce qu'Openview n'est pas": core and engine never read the
         machine. This is not the manoeuvre AGENTS.md 7 forbids -- 7 refuses LOOSENING a
         constraint to unblock a build, and this ADDS one (ADR 0003, decision 8).

         Verified: `plugins` declared in an override ADDS to the root `plugins`, so
         `no-double-cast` and `no-silent-catch` keep applying here. Verified too: this
         fourth override does NOT reset the `noRestrictedImports` of the first three, so the
         architecture guards stay alive.

         Declared in the OVERRIDE and not at the root on purpose: `designer`, `viewer` and
         `apps/playground` keep the right to call `new Date()`, which the playground needs.

         `noJsRestrictedProperties` is a NURSERY rule -- outside semantic versioning, so a
         Biome upgrade may rename or drop it silently. Replay the disposable probe at every
         upgrade; if the rule disappears, move these entries into the plugin, which belongs
         to this repository.

         The two pieces are COMPLEMENTARY, not redundant. This rule sees a computed
         `Date['now']()` and a destructured `const { now } = Date`, but never an ARGUMENT
         LIST. Everything that turns on arguments lives in the plugin, because no Biome rule
         reasons about them: `noRestrictedGlobals` knows names only, so banning `Intl` would
         also ban `Intl.NumberFormat('fr-FR')`, which lots C6 and E4 need. */
      "includes": ["packages/core/**", "packages/engine/**"],
      "plugins": ["./tools/biome/no-environment-read.grit"],
      "linter": {
        "rules": {
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "object": "Date",
                    "property": "now",
                    "message": "Date.now() reads the host clock, so two renders of one template cannot produce the same document (E6). The render date is data the integrator supplies, under whatever name it chooses."
                  },
                  {
                    "object": "Date",
                    "property": "parse",
                    "message": "Date.parse() is only specified for the ISO form; anywhere else its result is engine-dependent. Use civil-date.ts."
                  },
                  {
                    "object": "Math",
                    "property": "random",
                    "message": "Math.random() makes a render irreproducible (E6)."
                  },
                  {
                    "object": "process",
                    "property": "env",
                    "message": "process.env makes the render depend on the execution environment (E6)."
                  },
                  {
                    "object": "performance",
                    "message": "performance.now() is a clock, exactly like Date.now()."
                  },
                  {
                    "object": "globalThis",
                    "message": "globalThis.* is the back door to every global refused above. Deliberately broader than it needs to be: core and engine reference no global through it today, so the entry costs nothing. If a deterministic use ever appears, name it in the PR rather than widening the rule."
                  },
                  {
                    "property": "getFullYear",
                    "message": "The local Date getters read the host time zone: the same instant yields a different civil date in Auckland and in Los Angeles (E6). Use getUTC*, or civil-date.ts, which needs no Date at all."
                  },
                  {
                    "property": "getMonth",
                    "message": "The local Date getters read the host time zone (E6). Use getUTC*, or civil-date.ts."
                  },
                  {
                    "property": "getDate",
                    "message": "The local Date getters read the host time zone (E6). Use getUTC*, or civil-date.ts."
                  },
                  {
                    "property": "getDay",
                    "message": "The local Date getters read the host time zone (E6). Use getUTC*, or civil-date.ts."
                  },
                  {
                    "property": "getHours",
                    "message": "The local Date getters read the host time zone (E6). Use getUTC*, or civil-date.ts."
                  },
                  {
                    "property": "getMinutes",
                    "message": "The local Date getters read the host time zone (E6). Use getUTC*, or civil-date.ts."
                  },
                  {
                    "property": "getSeconds",
                    "message": "The local Date getters read the host time zone (E6). Use getUTC*, or civil-date.ts."
                  },
                  {
                    "property": "getMilliseconds",
                    "message": "The local Date getters read the host time zone (E6). Use getUTC*, or civil-date.ts."
                  },
                  {
                    "property": "getTimezoneOffset",
                    "message": "getTimezoneOffset() IS the host time zone (E6)."
                  },
                  {
                    "property": "toLocaleString",
                    "message": "toLocale* falls back to the host locale, and for a date to the host time zone as well. This ban is an over-approximation: it also refuses value.toLocaleString('fr-FR'), which does carry a locale -- the rule cannot see an argument list. Nothing is lost, because C6 formats through Intl.NumberFormat(locale) and Intl.DateTimeFormat(locale, { timeZone }), both of which stay allowed and say what they read."
                  },
                  {
                    "property": "toLocaleDateString",
                    "message": "toLocale* falls back to the host locale and, for a date, to the host time zone. Over-approximated on purpose: use Intl.DateTimeFormat(locale, { timeZone: 'UTC' }), which the plugin lets through."
                  },
                  {
                    "property": "toLocaleTimeString",
                    "message": "toLocale* falls back to the host locale and, for a date, to the host time zone. Over-approximated on purpose: use Intl.DateTimeFormat(locale, { timeZone: 'UTC' }), which the plugin lets through."
                  },
                  {
                    "property": "toLocaleUpperCase",
                    "message": "toLocale* reads the host locale, and toUpperCase() is what the algebra mandates instead."
                  },
                  {
                    "property": "toLocaleLowerCase",
                    "message": "toLocale* reads the host locale, and toLowerCase() is what the algebra mandates instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
